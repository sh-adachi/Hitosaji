# Copy to a private local .env file; this example contains no usable credentials.
# OPENAI_API_KEY remains only on the server. Never paste it into the iPhone app.
OPENAI_API_KEY=
# Generate independently, e.g. python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
HITOSAJI_ANALYSIS_TOKEN=
OPENAI_MODEL=gpt-4.1-mini
HOST=127.0.0.1
PORT=8080
